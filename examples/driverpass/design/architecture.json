{
  "description": "DriverPass slot assignment as a typed ArchiMate 3.2 model (subset). Checked by packages/design/scripts/designc.py; replaces the prose table in archimate-mapping.md as the source of truth.",
  "elements": [
    {"id": "G0", "type": "Goal", "name": "No invalid lesson allocation"},
    {"id": "BR-001", "type": "Requirement", "name": "Reject off-duty assignment"},
    {"id": "BR-002", "type": "Requirement", "name": "Reject duplicate slot"},
    {"id": "BR-003", "type": "Requirement", "name": "Accept and prepend a new slot"},
    {"id": "SR-001", "type": "Constraint", "name": "Rejection never mutates the roster"},
    {"id": "SR-002", "type": "Requirement", "name": "One IMMEDIATE transaction per request"},
    {"id": "SR-003", "type": "Requirement", "name": "Audit every attempt"},

    {"id": "BP-assign", "type": "BusinessProcess", "name": "Assign instructor slot",
     "trace": [{"file": "examples/driverpass/design/sequence.puml", "anchor": "POST /api/v1/instructors/7/slots"}]},

    {"id": "AC-backend", "type": "ApplicationComponent", "name": "DriverPass backend",
     "trace": [{"file": "examples/driverpass/backend/Cargo.toml", "anchor": "name = \"driverpass-poc\""}]},
    {"id": "AS-allocation-api", "type": "ApplicationService", "name": "Allocation API",
     "trace": [{"file": "examples/driverpass/contracts/openapi.yaml", "anchor": "/api/v1/instructors/{id}/slots:"},
               {"file": "examples/driverpass/backend/src/main.rs", "anchor": "async fn assign_slot"}]},
    {"id": "AF-decide", "type": "ApplicationFunction", "name": "Decision function",
     "trace": [{"file": "examples/driverpass/backend/src/domain.rs", "anchor": "pub fn allocate"},
               {"file": "examples/driverpass/formal/DriverPass.lean", "anchor": "def allocate"}]},
    {"id": "AF-transact", "type": "ApplicationFunction", "name": "Transactional assignment",
     "trace": [{"file": "examples/driverpass/backend/src/service.rs", "anchor": "pub fn assign_slot_tx"},
               {"file": "examples/driverpass/formal/Transactions.lean", "anchor": "def assignTx"}]},
    {"id": "DO-roster", "type": "DataObject", "name": "InstructorRoster",
     "trace": [{"file": "examples/driverpass/backend/src/domain.rs", "anchor": "pub struct Roster"}]},
    {"id": "DO-decision", "type": "DataObject", "name": "Decision",
     "trace": [{"file": "examples/driverpass/backend/src/domain.rs", "anchor": "pub enum Decision"}]},
    {"id": "DO-audit", "type": "DataObject", "name": "Allocation audit record",
     "trace": [{"file": "examples/driverpass/backend/src/service.rs", "anchor": "CREATE TABLE IF NOT EXISTS allocation_audit"}]},

    {"id": "SS-sqlite", "type": "SystemSoftware", "name": "SQLite",
     "trace": [{"file": "examples/driverpass/backend/Cargo.toml", "anchor": "rusqlite"}]},
    {"id": "SS-axum", "type": "SystemSoftware", "name": "Rust/Axum runtime",
     "trace": [{"file": "examples/driverpass/backend/Cargo.toml", "anchor": "axum"}]},
    {"id": "N-container", "type": "Node", "name": "Docker container",
     "trace": [{"file": "examples/driverpass/infra/Dockerfile", "anchor": "FROM debian:bookworm-slim"}]},
    {"id": "ART-binary", "type": "Artifact", "name": "driverpass-poc binary",
     "trace": [{"file": "examples/driverpass/infra/Dockerfile", "anchor": "/usr/local/bin/driverpass-poc"}]}
  ],
  "relationships": [
    {"type": "realization", "from": "BR-001", "to": "G0"},
    {"type": "realization", "from": "BR-002", "to": "G0"},
    {"type": "realization", "from": "BR-003", "to": "G0"},
    {"type": "realization", "from": "SR-001", "to": "G0"},
    {"type": "realization", "from": "SR-002", "to": "G0"},
    {"type": "realization", "from": "SR-003", "to": "G0"},

    {"type": "realization", "from": "AF-decide", "to": "BR-001"},
    {"type": "realization", "from": "AF-decide", "to": "BR-002"},
    {"type": "realization", "from": "AF-decide", "to": "BR-003"},
    {"type": "realization", "from": "AF-decide", "to": "SR-001"},
    {"type": "realization", "from": "AF-transact", "to": "SR-002"},
    {"type": "realization", "from": "AF-transact", "to": "SR-003"},

    {"type": "serving", "from": "AS-allocation-api", "to": "BP-assign"},
    {"type": "realization", "from": "AC-backend", "to": "AS-allocation-api"},
    {"type": "realization", "from": "AF-transact", "to": "AS-allocation-api"},
    {"type": "assignment", "from": "AC-backend", "to": "AF-transact"},
    {"type": "assignment", "from": "AC-backend", "to": "AF-decide"},
    {"type": "triggering", "from": "AF-transact", "to": "AF-decide"},
    {"type": "access", "from": "AF-decide", "to": "DO-roster"},
    {"type": "access", "from": "AF-decide", "to": "DO-decision"},
    {"type": "access", "from": "AF-transact", "to": "DO-roster"},
    {"type": "access", "from": "AF-transact", "to": "DO-audit"},

    {"type": "serving", "from": "SS-sqlite", "to": "AC-backend"},
    {"type": "serving", "from": "SS-axum", "to": "AC-backend"},
    {"type": "composition", "from": "N-container", "to": "SS-sqlite"},
    {"type": "composition", "from": "N-container", "to": "SS-axum"},
    {"type": "assignment", "from": "N-container", "to": "ART-binary"},
    {"type": "realization", "from": "ART-binary", "to": "AC-backend"}
  ]
}
