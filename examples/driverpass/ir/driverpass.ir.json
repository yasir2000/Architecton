    {"id": "ART-SMOKE", "path": "examples/driverpass/scripts/smoke.py", "sha256": "2ea656ed0e188c73a0add4755c3d69b0effa06f720144fd560892eb20832fb95"}
  ],
  "goals": [
    {
      "id": "G0",
      "parent": null,
      "statement": "An instructor must never acquire an invalid lesson allocation.",
      "provenance": [
        {"artifact": "ART-BRD", "anchor": "make reservations for customers", "role": "source"},
        {"artifact": "ART-GOALS", "anchor": "**G0:**", "role": "design"}
      ]
    },
    {"id": "G1", "parent": "G0", "statement": "If off duty at the instant of assignment, reject it.",
     "provenance": [{"artifact": "ART-GOALS", "anchor": "G1 (BR-001)", "role": "design"}]},
    {"id": "G2", "parent": "G0", "statement": "If the same instructor already holds the slot, reject it.",
     "provenance": [{"artifact": "ART-GOALS", "anchor": "G2 (BR-002)", "role": "design"}]},
    {"id": "G3", "parent": "G0", "statement": "Otherwise assign the slot exactly once.",
     "provenance": [{"artifact": "ART-GOALS", "anchor": "G3 (BR-003)", "role": "design"}]},
    {"id": "G4", "parent": "G0", "statement": "All rejection outcomes leave the roster unchanged.",
     "provenance": [{"artifact": "ART-GOALS", "anchor": "G4 (SR-001)", "role": "design"}]},
    {"id": "G5", "parent": "G0", "statement": "Read, decide and write form one atomic SQLite transaction.",
     "provenance": [{"artifact": "ART-GOALS", "anchor": "G5 (SR-002)", "role": "design"}]},
    {"id": "G6", "parent": "G0", "statement": "Every processed attempt for a known instructor produces a durable audit record.",
     "provenance": [{"artifact": "ART-GOALS", "anchor": "G6 (SR-003)", "role": "design"}]}
  ],
  "requirements": [
    {
      "id": "BR-001", "kind": "business", "goals": ["G1"],
      "statement": "Reject assignment if the instructor is off duty.",
      "provenance": [
        {"artifact": "ART-POLICY", "anchor": "BR-001", "role": "source"},
        {"artifact": "ART-LEAN-PROOFS", "anchor": "theorem offDuty_denied", "role": "proof"},
        {"artifact": "ART-RUST-DOMAIN", "anchor": "pub fn allocate", "role": "implementation"},
        {"artifact": "ART-SCENARIOS", "anchor": "off_duty", "role": "test"}
      ]
    },
    {
      "id": "BR-002", "kind": "business", "goals": ["G2"],
      "statement": "Reject assignment if this instructor already holds this slot.",
      "provenance": [
        {"artifact": "ART-POLICY", "anchor": "BR-002", "role": "source"},
        {"artifact": "ART-LEAN-PROOFS", "anchor": "theorem duplicate_denied", "role": "proof"},
        {"artifact": "ART-RUST-DOMAIN", "anchor": "pub fn allocate", "role": "implementation"},
        {"artifact": "ART-SCENARIOS", "anchor": "duplicate", "role": "test"}
      ]
    },
    {
      "id": "BR-003", "kind": "business", "goals": ["G3"],
      "statement": "Accept and prepend a previously unassigned slot.",
      "provenance": [
        {"artifact": "ART-POLICY", "anchor": "BR-003", "role": "source"},
        {"artifact": "ART-LEAN-PROOFS", "anchor": "theorem accepted_prepends_slot", "role": "proof"},
        {"artifact": "ART-RUST-DOMAIN", "anchor": "pub fn allocate", "role": "implementation"},
        {"artifact": "ART-SCENARIOS", "anchor": "accepted", "role": "test"}
      ]
    },
    {
      "id": "SR-001", "kind": "nonfunctional", "goals": ["G4"],
      "statement": "No rejected assignment may mutate the roster.",
      "provenance": [
        {"artifact": "ART-POLICY", "anchor": "SR-001", "role": "source"},
        {"artifact": "ART-LEAN-PROOFS", "anchor": "theorem rejected_preserves_roster", "role": "proof"},
        {"artifact": "ART-RUST-DOMAIN", "anchor": "pub fn allocate", "role": "implementation"}
      ]
    },
    {
      "id": "SR-002", "kind": "nonfunctional", "goals": ["G5"],
      "statement": "Each API request is executed in one SQLite IMMEDIATE transaction.",
      "provenance": [
        {"artifact": "ART-POLICY", "anchor": "SR-002", "role": "source"},
        {"artifact": "ART-SEQUENCE-UML", "anchor": "BEGIN IMMEDIATE", "role": "design"},
        {"artifact": "ART-RUST-API", "anchor": "async fn assign_slot", "role": "implementation"},
        {"artifact": "ART-SMOKE", "anchor": "\"POST\", \"/api/v1/instructors/7/slots\"", "role": "test"}
      ]
    },
    {
      "id": "SR-003", "kind": "nonfunctional", "goals": ["G6"],
      "statement": "Every attempted assignment of a known instructor is recorded in durable audit history.",
      "provenance": [
        {"artifact": "ART-POLICY", "anchor": "SR-003", "role": "source"},
        {"artifact": "ART-RUST-API", "anchor": "audit", "role": "implementation"},
        {"artifact": "ART-SMOKE", "anchor": "audit", "role": "test"}
      ]
    }
  ],
  "risks": [
    {
      "id": "RK-001", "status": "mitigated", "mitigated_by": ["SR-002"],
      "statement": "Concurrent requests read the same roster and double-book a slot (lost update).",
      "provenance": [{"artifact": "ART-GOALS", "anchor": "G5 (SR-002)", "role": "design"}]
    },
    {
      "id": "RK-002", "status": "mitigated", "mitigated_by": ["SR-001", "BR-001", "BR-002"],
      "statement": "A rejected attempt silently changes the roster.",
      "provenance": [{"artifact": "ART-GOALS", "anchor": "G4 (SR-001)", "role": "design"}]
    },
    {
      "id": "RK-003", "status": "mitigated", "mitigated_by": ["SR-003"],
      "statement": "Assignment attempts leave no audit trail.",
      "provenance": [{"artifact": "ART-GOALS", "anchor": "G6 (SR-003)", "role": "design"}]
    },
    {
      "id": "RK-004", "status": "accepted", "mitigated_by": [],
      "statement": "Organization-wide resource conflicts, test capacity, travel time and overlapping slot intervals are not modeled.",
      "provenance": [{"artifact": "ART-GOALS", "anchor": "**Deliberate scope:**", "role": "design"}]
    },
    {
      "id": "RK-005", "status": "open", "mitigated_by": [],
      "statement": "The Lean model and the Rust implementation diverge on inputs outside the shared scenarios and bounded sweep.",
      "provenance": [{"artifact": "ART-GOALS", "anchor": "It does **not** prove the above relation", "role": "design"}]
    }
  ],
  "state_vars": [
    {"name": "offDuty", "type": "Bool"},
    {"name": "slots", "type": "List Nat"}
  ],
  "transitions": [
    {
      "id": "TR-assign_slot",
      "params": [{"name": "slot", "type": "Nat"}],
      "guards": [
        {"requirement": "BR-001", "when": {"var": "offDuty"}, "outcome": "off_duty"},
        {"requirement": "BR-002", "when": {"contains": [{"var": "slots"}, {"param": "slot"}]}, "outcome": "duplicate"}
      ],
      "otherwise": {
        "requirement": "BR-003",
        "outcome": "accepted",
        "effect": [
          {"var": "slots", "value": {"cons": [{"param": "slot"}, {"var": "slots"}]}}
        ]
      }
    }
  ],
  "invariants": [
    {
      "id": "INV-001", "requirement": "BR-002",
      "statement": "An instructor never holds the same slot twice.",
      "body": {"nodup": {"var": "slots"}}
    }
  ]
}
